{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s: %(message)s"
    }
  },
  "handlers": {
    "default": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["default"]
  },
  "loggers": {
    "uvicorn": { "level": "INFO" },
    "uvicorn.error": { "level": "INFO" },
    "uvicorn.access": { "level": "INFO" }
  }
}
