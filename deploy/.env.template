# Reference copy of the environment the app expects.
#
# On the server this lives at /opt/foodbodyconnection/.env (chmod 600, owned by
# the foodbody user) and is loaded by the systemd unit.
# For local dev, copy to backend/.env — it is gitignored.
#
# The authoritative values are on the Oracle box:
#   ./ssh.sh 'sudo cat /opt/foodbodyconnection/.env'

# Neon PostgreSQL connection string (console.neon.tech → Connection Details).
# NOTE: this is the live production database — a local run writes real data.
DB_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# PostgreSQL superuser connection — only used by scripts/create_tables.py
DB_MAINT_URL=

# JWT settings — generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Does not need to match the server; changing it only invalidates local logins.
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fernet key for field-level encryption of user data (app/core/encryption.py).
# MUST be byte-identical to the server's value — a different key means existing
# encrypted rows silently fall back to returning ciphertext.
FIELD_ENCRYPTION_KEY=

# Anthropic API key for AI-generated analysis summaries and chat
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Gmail app password for sending password reset emails
# Generate at: myaccount.google.com → Security → App passwords
SMTP_PASSWORD=<your-gmail-app-password>

# Writable paths.
#
# UPLOAD_DIR MUST be set on the server. Its default is /tmp/user_docs, and
# systemd-tmpfiles empties /tmp on every boot — leaving it unset means every
# uploaded document is destroyed the next time the box restarts. Extracted text
# survives in the database; the original files do not.
#
# Locally, point both at a directory you own so the app does not need root.
PLOT_CACHE_DIR=/opt/foodbodyconnection/plot_cache
UPLOAD_DIR=/opt/foodbodyconnection/user_docs
