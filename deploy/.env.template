# Copy this to /opt/foodbodyconnection/.env and fill in the values.
# setup.sh writes this file automatically — only use this as a reference.

# PostgreSQL connection string for the app
DB_URL=postgresql://foodbody:YOUR_DB_PASSWORD@localhost/foodbodyconnection

# PostgreSQL superuser connection (used only by scripts/create_tables.py)
DB_MAINT_URL=postgresql://postgres:YOUR_POSTGRES_SUPERUSER_PASSWORD@localhost/postgres

# JWT settings — generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anthropic API key for AI-generated analysis summaries
ANTHROPIC_API_KEY=<your-anthropic-api-key>
