[Unit]
Description=Food Body Connection API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=foodbody
Group=foodbody
WorkingDirectory=/opt/foodbodyconnection
EnvironmentFile=/opt/foodbodyconnection/.env

ExecStart=/opt/foodbodyconnection/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info \
    --log-config /opt/foodbodyconnection/log_config.json

Restart=always
RestartSec=10

# Redirect stdout/stderr to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=foodbodyconnection

[Install]
WantedBy=multi-user.target
